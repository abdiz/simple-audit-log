{
    "name": "abdi.zbn/simple-audit-log",
    "description": "Keep the history of Eloquent model changes in Laravel with a single trait.",
    "type": "library",
    "license": "MIT",
    "keywords": ["Laravel", "Audit", "Log", "Eloquent"],
    "authors": [
        {
            "name": "Zeinab Abdi",
            "email": "abdi.zbn@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "ext-json": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5.3 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "AbdiZbn\\SimpleAuditLog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AbdiZbn\\SimpleAuditLog\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "AbdiZbn\\SimpleAuditLog\\SimpleAuditLogServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
